{
  "name": "oda",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "pnpm install",
    "build:all": "pnpm -r run build",
    "prisma:generate": "pnpm -F @oda/database run prisma:generate",
    "prisma:studio": "pnpm -F @oda/database run prisma:studio",
    "prisma:push": "pnpm -F @oda/database run prisma:push",
    "prisma:seed": "pnpm -F @oda/database run prisma:seed",
    "backup:db": "C:\\Progra~1\\Git\\usr\\bin\\bash.exe -lc \"scripts/backup-db.sh \\\"$@\\\"\" --",
    "dev:api": "pnpm -F @oda/api start:dev",
    "dev:langchain": "pnpm -F @oda/langchain dev",
    "run:scraper": "pnpm -F @oda/scraper start",
    "scraper:dgp": "pnpm -F @oda/scraper start dgp",
    "scraper:discovery": "pnpm -F @oda/scraper start discovery",
    "scraper:lattes": "pnpm -F @oda/scraper start lattes",
    "etl": "pnpm -F @oda/etl start all",
    "etl:grupo": "pnpm -F @oda/etl start grupo",
    "etl:pesquisador": "pnpm -F @oda/etl start pesquisador",
    "openalex:areas": "pnpm -F @oda/etl run export:openalex-areas",
    "openalex:areas:import": "pnpm -F @oda/etl run import:openalex-areas",
    "openalex:areas:relacionar": "pnpm -F @oda/etl run relate:openalex-areas",
    "fix:dgp-areas": "pnpm -F @oda/etl run fix:dgp-areas",
    "fix:producoes-doi-openalex": "pnpm -F @oda/etl run fix:producoes-doi-openalex",
    "move:images": "node scripts/move-images-to-api-static.mjs",
    "download:instituicoes": "node scripts/download-instituicao-logos.mjs",
    "ingest:db": "pnpm -F @oda/langchain run ingest-db",
    "web:dev": "pnpm -F @oda/web dev "
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "prisma": "^7.8.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "bullmq": "^5.79.0",
    "dotenv": "^16.6.1"
  }
}
