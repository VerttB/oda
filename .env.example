POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=
DATABASE_URL=

# Servidor principal: core; secundario: scraper; terciario: simcc.
# Desenvolvimento em uma maquina: core,scraper,simcc.
COMPOSE_PROFILES=core,scraper
# Rede dos comandos RUN no build. Use host no Linux se o DNS do builder falhar.
DOCKER_BUILD_NETWORK=default
# Apenas nos servidores de workers: enderecos do servidor principal via Mesh.
# Exemplo: postgresql://usuario:senha@100.96.x.x:5433/oda
DOCKER_DATABASE_URL=
# Exemplo: redis://100.96.x.x:6379/0
DOCKER_REDIS_URL=
# No principal, use o IP Mesh para permitir acesso remoto privado.
POSTGRES_BIND_IP=127.0.0.1
REDIS_BIND_IP=127.0.0.1

# Comandos pnpm no host acessam o Redis publicado pelo Docker local.
# Dentro de um container da mesma rede, use redis://redis:6379/0.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
DGP_WORKER_NAME=
LATTES_WORKER_NAME=
DISCOVERY_WORKER_NAME=
ETL_GROUP_WORKER_NAME=
ETL_RESEARCHER_WORKER_NAME=
# Opcional no host; o container ETL usa /data.
SCRAPER_DATA_DIR=

LANGCHAIN_host=
LANGCHAIN_PORT=


OPEN_ALEX_KEY=
DOI_API_URL=



GOOGLE_API_KEY=
GOOGLE_API_VERSION=
GOOGLE_TRANSLATE_API_KEY=
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
LANGCHAIN_PORT=

OPEN_AI_KEY=

CRAWLEE_REQUEST_HANDLER_TIMEOUT_SECS=


JWT_SECRET=
ADMIN_USER=admin
# ADMIN_USERNAME continua aceito como alias legado; ADMIN_USER tem prioridade.
ADMIN_PASSWORD=
TRUST_PROXY_HOPS=0
# Base publica usada pelo Swagger. Para Nginx em /oda/, configure /oda.
SWAGGER_SERVER_URL=/

# URL pública da API. O frontend acrescenta /v1 e também aceita a URL já versionada.
# Imagens continuam na raiz /static; o proxy local usa /api/v1 para consultas.
VITE_PUBLIC_BASE_URL=http://localhost:3000
