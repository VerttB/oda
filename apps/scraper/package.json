{
  "name": "@oda/scraper",
  "version": "1.0.0",
  "description": "Scraper microservice rewritten in TypeScript.",
  "private": true,
  "scripts": {
    "start": "ts-node src/main.ts",
    "reset-queue": "ts-node src/resetQueue.ts",
    "reset-researchers-queue": "ts-node src/resetResearchersQueue.ts",
    "check-pending-lattes-raw": "ts-node src/checkPendingLattesRawFiles.ts",
    "build": "tsc",
    "queue:prepare": "pnpm --filter @oda/scraper... run build --incremental false",
    "queue:dgp": "node dist/queue/dgp/dgpCli.js",
    "queue:lattes": "node dist/queue/lattes/lattesCli.js",
    "queue:discovery": "node dist/queue/discovery/discoveryCli.js",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@crawlee/playwright": "^3.17.0",
    "@oda/database": "workspace:*",
    "@oda/queue": "workspace:*",
    "@oda/shared-types": "workspace:*",
    "cheerio": "^1.0.0",
    "crawlee": "^3.17.0",
    "dotenv": "^16.4.7",
    "playwright": "^1.50.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
