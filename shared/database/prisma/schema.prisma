// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  moduleFormat    = "esm"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgvector(map: "vector")]
}

// Domínio da API
model Instituicao {
  id                     String                     @id @default(uuid())
  nome                   String
  sigla                  String
  estado                 Estado?                    @relation(fields: [estadoId], references: [id])
  estadoId               String?                    @map("estado_id")
  gruposPesquisaVinculos GrupoPesquisaInstituicao[]

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("instituicao")
}

enum TipoRelacaoGrupoInstituicao {
  SEDE     @map("sede")
  PARCEIRA @map("parceira")

  @@map("tipo_relacao_grupo_instituicao")
}

model GrupoPesquisaInstituicao {
  grupoId       String                      @map("grupo_id")
  instituicaoId String                      @map("instituicao_id")
  tipoRelacao   TipoRelacaoGrupoInstituicao @map("tipo_relacao")
  unidade       String?
  unidadeUf     String?                     @map("unidade_uf")
  grupoPesquisa GrupoPesquisa               @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  instituicao   Instituicao                 @relation(fields: [instituicaoId], references: [id])
  criadoEm      DateTime                    @default(now()) @map("criado_em")
  atualizadoEm  DateTime                    @updatedAt @map("atualizado_em")

  @@id([grupoId, instituicaoId])
  @@index([instituicaoId])
  @@index([tipoRelacao])
  @@map("grupo_pesquisa_instituicao")
}

model Estado {
  id           String        @id @default(uuid())
  sigla        String        @unique
  nome         String
  regiao       String
  instituicoes Instituicao[]
  criadoEm     DateTime      @default(now()) @map("criado_em")
  atualizadoEm DateTime      @updatedAt @map("atualizado_em")

  @@map("estado")
}

enum Situacao {
  ATIVO      @map("certificado")
  INATIVO    @map("inativo")
  EM_ANALISE @map("em_analise")

  @@map("situacao")
}

model GrupoPesquisa {
  id                String                          @id @default(uuid())
  dgpId             String?                         @unique @map("dgp_id")
  nome              String
  anoFormacao       Int?                            @map("ano_formacao")
  areaPredominante  String                          @map("area_predominante")
  repercussao       String?
  email             String?
  telefone          String?
  website           String?
  logradouro        String?
  numero            String?
  complemento       String?
  bairro            String?
  cidade            String?
  uf                String?
  cep               String?
  latitude          Float?
  longitude         Float?
  areasConhecimento GrupoPesquisaAreaConhecimento[]
  instituicoes      GrupoPesquisaInstituicao[]
  situacao          Situacao                        @default(ATIVO)
  membros           MembroGrupo[]
  linhasPesquisa    LinhaPesquisa[]
  criadoEm          DateTime                        @default(now()) @map("criado_em")
  atualizadoEm      DateTime                        @updatedAt @map("atualizado_em")

  @@map("grupo_pesquisa")
}

model LinhaPesquisa {
  id               String                        @id @default(uuid())
  dgpId            String?                       @unique @map("dgp_id")
  titulo           String
  objetivo         String?
  grupo            GrupoPesquisa                 @relation(fields: [grupoId], references: [id])
  grupoId          String                        @map("grupo_id")
  membros          MembroLinhaPesquisa[]
  palavrasChave    LinhaPesquisaPalavraChave[]
  setoresAplicacao LinhaPesquisaSetorAplicacao[]
  criadoEm         DateTime                      @default(now()) @map("criado_em")
  atualizadoEm     DateTime                      @updatedAt @map("atualizado_em")

  @@map("linha_pesquisa")
}

enum TipoPesquisador {
  TECNICO                 @map("tecnico")
  ESTUDANTE               @map("estudante")
  PESQUISADOR             @map("pesquisador")
  COLABORADOR_ESTRANGEIRO @map("colaborador_estrangeiro")

  @@map("tipo_pesquisador")
}

enum FormacaoAcademica {
  GRADUACAO      @map("graduacao")
  ESPECIALIZACAO @map("especializacao")
  MESTRADO       @map("mestrado")
  DOUTORADO      @map("doutorado")
  OUTRO          @map("outro")

  @@map("formacao_academica")
}

model Pesquisador {
  id                   String                          @id @default(uuid())
  lattesId             String?                         @unique @map("lattes_id")
  nome                 String
  tipo                 TipoPesquisador?
  formacaoAcademica    FormacaoAcademica?              @map("formacao_academica")
  membrosGrupo         MembroGrupo[]
  membrosLinhaPesquisa MembroLinhaPesquisa[]
  producoes            ProducaoPesquisador[]
  areasConhecimento    PesquisadoresAreaConhecimento[]
  openAlexId           String?                         @unique @map("open_alex_id")
  orcidId              String?                         @unique @map("orcid_id")
  imageUrl             String?                         @map("image_url")
  indexH               Int?                            @map("index_h")
  indexI10             Int?                            @map("index_i_10")
  criadoEm             DateTime                        @default(now()) @map("criado_em")
  atualizadoEm         DateTime                        @updatedAt @map("atualizado_em")

  @@map("pesquisador")
}

model MembroGrupo {
  pesquisador   Pesquisador   @relation(fields: [pesquisadorId], references: [id])
  pesquisadorId String        @map("pesquisador_id")
  grupoPesquisa GrupoPesquisa @relation(fields: [grupoId], references: [id])
  grupoId       String        @map("grupo_id")
  eLider        Boolean       @default(false) @map("e_lider")
  dataEntrada   DateTime?     @map("data_entrada")
  criadoEm      DateTime      @default(now()) @map("criado_em")
  atualizadoEm  DateTime      @updatedAt @map("atualizado_em")

  @@id([pesquisadorId, grupoId])
  @@map("membro_grupo")
}

model MembroLinhaPesquisa {
  linhaPesquisa   LinhaPesquisa @relation(fields: [linhaPesquisaId], references: [id])
  linhaPesquisaId String        @map("linha_pesquisa_id")
  pesquisador     Pesquisador   @relation(fields: [pesquisadorId], references: [id])
  pesquisadorId   String        @map("pesquisador_id")
  criadoEm        DateTime      @default(now()) @map("criado_em")

  @@id([linhaPesquisaId, pesquisadorId])
  @@map("membro_linha_pesquisa")
}

model AreaConhecimento {
  id              String                          @id @default(uuid())
  nome            String
  nomeNormalizado String                          @unique
  areaPai         AreaConhecimento?               @relation("AreaConhecimentoHierarquia", fields: [areaPaiId], references: [id])
  areaPaiId       String?                         @map("area_pai_id")
  subareas        AreaConhecimento[]              @relation("AreaConhecimentoHierarquia")
  gruposPesquisa  GrupoPesquisaAreaConhecimento[]
  pesquisadores   PesquisadoresAreaConhecimento[]
  criadoEm        DateTime                        @default(now()) @map("criado_em")
  atualizadoEm    DateTime                        @updatedAt @map("atualizado_em")

  @@map("area_conhecimento")
}

model PesquisadoresAreaConhecimento {
  pesquisador   Pesquisador      @relation(fields: [pesquisadorId], references: [id])
  pesquisadorId String           @map("pesquisador_id")
  area          AreaConhecimento @relation(fields: [areaId], references: [id])
  areaId        String           @map("area_conhecimento_id")

  @@id([pesquisadorId, areaId])
  @@map("pesquisador_area_conhecimento")
}

model GrupoPesquisaAreaConhecimento {
  grupo   GrupoPesquisa    @relation(fields: [grupoId], references: [id])
  grupoId String           @map("grupo_id")
  area    AreaConhecimento @relation(fields: [areaId], references: [id])
  areaId  String           @map("area_conhecimento_id")

  @@id([grupoId, areaId])
  @@map("grupo_pesquisa_area_conhecimento")
}

model PalavraChave {
  id               String                      @id @default(uuid())
  termo            String                      @unique
  termoNormalizado String                      @unique @map("termo_normalizado")
  linhasPesquisa   LinhaPesquisaPalavraChave[]
  producoes        ProducaoPalavraChave[]
  criadoEm         DateTime                    @default(now()) @map("criado_em")
  atualizadoEm     DateTime                    @updatedAt @map("atualizado_em")

  @@map("palavra_chave")
}

model SetorAplicacao {
  id              String                        @id @default(uuid())
  nome            String                        @unique
  nomeNormalizado String                        @unique @map("nome_normalizado")
  linhasPesquisa  LinhaPesquisaSetorAplicacao[]
  criadoEm        DateTime                      @default(now()) @map("criado_em")
  atualizadoEm    DateTime                      @updatedAt @map("atualizado_em")

  @@map("setor_aplicacao")
}

model LinhaPesquisaSetorAplicacao {
  linhaPesquisa    LinhaPesquisa  @relation(fields: [linhaPesquisaId], references: [id])
  linhaPesquisaId  String         @map("linha_pesquisa_id")
  setorAplicacao   SetorAplicacao @relation(fields: [setorAplicacaoId], references: [id])
  setorAplicacaoId String         @map("setor_aplicacao_id")
  criadoEm         DateTime       @default(now()) @map("criado_em")

  @@id([linhaPesquisaId, setorAplicacaoId])
  @@map("linha_pesquisa_setor_aplicacao")
}

model LinhaPesquisaPalavraChave {
  linhaPesquisa   LinhaPesquisa @relation(fields: [linhaPesquisaId], references: [id])
  linhaPesquisaId String        @map("linha_pesquisa_id")
  palavraChave    PalavraChave  @relation(fields: [palavraChaveId], references: [id])
  palavraChaveId  String        @map("palavra_chave_id")
  criadoEm        DateTime      @default(now()) @map("criado_em")

  @@id([linhaPesquisaId, palavraChaveId])
  @@map("linha_pesquisa_palavra_chave")
}

enum TipoProducao {
  ARTIGO        @map("artigo")
  LIVROCAPITULO @map("livro_capitulo")
  OUTRA         @map("outra")

  @@map("tipo_producao")
}

enum Qualis {
  A1
  A2
  A3
  A4
  B1
  B2
  B3
  B4
  C

  @@map("qualis_estrato")
}

model Producao {
  id            String                 @id @default(uuid())
  titulo        String
  ano           Int?
  tipo          TipoProducao           @default(OUTRA)
  doi           String?                @unique
  url           String?
  veiculo       String?
  issn          String?
  qualis        Qualis?
  resumo        String?
  autores       ProducaoPesquisador[]
  palavrasChave ProducaoPalavraChave[]
  criadoEm      DateTime               @default(now()) @map("criado_em")
  atualizadoEm  DateTime               @updatedAt @map("atualizado_em")

  @@map("producao")
}

model ProducaoPesquisador {
  producao      Producao    @relation(fields: [producaoId], references: [id])
  producaoId    String      @map("producao_id")
  pesquisador   Pesquisador @relation(fields: [pesquisadorId], references: [id])
  pesquisadorId String      @map("pesquisador_id")
  ordemAutoria  Int?        @map("ordem_autoria")
  criadoEm      DateTime    @default(now()) @map("criado_em")

  @@id([producaoId, pesquisadorId])
  @@map("producao_pesquisador")
}

model ProducaoPalavraChave {
  producao       Producao     @relation(fields: [producaoId], references: [id])
  producaoId     String       @map("producao_id")
  palavraChave   PalavraChave @relation(fields: [palavraChaveId], references: [id])
  palavraChaveId String       @map("palavra_chave_id")
  criadoEm       DateTime     @default(now()) @map("criado_em")

  @@id([producaoId, palavraChaveId])
  @@map("producao_palavra_chave")
}

enum RagSourceType {
  GRUPO_PESQUISA    @map("grupo_pesquisa")
  LINHA_PESQUISA    @map("linha_pesquisa")
  PESQUISADOR       @map("pesquisador")
  PRODUCAO          @map("producao")
  AREA_CONHECIMENTO @map("area_conhecimento")

  @@map("rag_source_type")
}

enum IndexingJobStatus {
  PENDENTE     @map("pendente")
  EM_ANDAMENTO @map("em_andamento")
  CONCLUIDO    @map("concluido")
  ERRO         @map("erro")

  @@map("indexing_job_status")
}

model RagDocument {
  id           String        @id @default(uuid())
  sourceType   RagSourceType @map("source_type")
  sourceId     String        @map("source_id")
  titulo       String?
  conteudo     String?
  metadata     Json?
  chunks       RagChunk[]
  criadoEm     DateTime      @default(now()) @map("criado_em")
  atualizadoEm DateTime      @updatedAt @map("atualizado_em")

  @@unique([sourceType, sourceId])
  @@index([sourceType, sourceId])
  @@map("rag_document")
}

model RagChunk {
  id           String                       @id @default(uuid())
  document     RagDocument                  @relation(fields: [documentId], references: [id])
  documentId   String                       @map("document_id")
  conteudo     String
  embedding    Unsupported("vector(1536)")?
  ordem        Int                          @default(0)
  tokenCount   Int?                         @map("token_count")
  metadata     Json?
  criadoEm     DateTime                     @default(now()) @map("criado_em")
  atualizadoEm DateTime                     @updatedAt @map("atualizado_em")

  @@index([documentId])
  @@map("rag_chunk")
}

model IndexingJob {
  id           String            @id @default(uuid())
  sourceType   RagSourceType     @map("source_type")
  sourceId     String            @map("source_id")
  status       IndexingJobStatus @default(PENDENTE)
  erro         String?
  tentativas   Int               @default(0)
  criadoEm     DateTime          @default(now()) @map("criado_em")
  atualizadoEm DateTime          @updatedAt @map("atualizado_em")

  @@index([status])
  @@index([sourceType, sourceId])
  @@map("indexing_job")
}

// Domínio do Scrapper

enum StatusColeta {
  EMANDAMENTO @map("em_andamento")
  CONCLUIDA   @map("concluida")

  @@map("status_coleta")
}

enum ModuloSistema {
  SCRAPER
  ETL
  RAG
}

enum ModoExecucao {
  COMPLETA
  APENAS_DGP
  APENAS_LATTES
}

enum StatusSessao {
  EMANDAMENTO
  CONCLUIDO
  ERRO
}

enum TipoEntidadeLog {
  GRUPO
  PESQUISADOR
  LINHA_PESQUISA
  GERAL
}

enum StatusItemLog {
  SUCESSO
  ERRO
}

enum TipoErroColeta {
  TIMEOUT
  NAO_ENCONTRADO
  BLOCKED_CAPTCHA
  ESTRUTURA_HTML_INVALIDA
  ERRO_REDE
  FALHA_ETL
  EMBEDDING_RATE_LIMIT
  EMBEDDING_API_KEY_INVALIDA
  EMBEDDING_FALHA_CALCULO
  EMBEDDING_CONEXAO_LLM
  DESCONHECIDO
}

model PipelineLog {
  id                   String            @id @default(uuid())
  modulo               ModuloSistema
  dgpId                String?           @map("dgp_id")
  modoExecucao         ModoExecucao      @default(COMPLETA) @map("modo_execucao")
  status               StatusSessao      @default(EMANDAMENTO)
  registrosProcessados Int               @default(0) @map("registros_processados")
  quantidadeSucessos   Int               @default(0) @map("quantidade_sucessos")
  quantidadeErros      Int               @default(0) @map("quantidade_erros")
  dataInicio           DateTime          @default(now()) @map("data_inicio")
  dataFim              DateTime?         @map("data_fim")
  duracaoMs            Int?              @map("duracao_ms")
  metadata             Json?             @map("metadata")
  itens                PipelineLogItem[]
  criadoEm             DateTime          @default(now()) @map("criado_em")
  atualizadoEm         DateTime          @updatedAt @map("atualizado_em")

  @@index([modulo, status])
  @@index([dgpId])
  @@map("pipeline_log")
}

model PipelineLogItem {
  id            String          @id @default(uuid())
  pipelineLog   PipelineLog     @relation(fields: [pipelineLogId], references: [id], onDelete: Cascade)
  pipelineLogId String          @map("pipeline_log_id")
  entidadeId    String?         @map("entidade_id")
  tipoEntidade  TipoEntidadeLog @default(GRUPO) @map("tipo_entidade")
  etapa         String?
  status        StatusItemLog
  tipoErro      TipoErroColeta? @map("tipo_erro")
  mensagemErro  String?         @map("mensagem_erro")
  detalhesErro  String?         @map("detalhes_erro")
  tempoMs       Int?            @map("tempo_ms")
  criadoEm      DateTime        @default(now()) @map("criado_em")

  @@index([pipelineLogId])
  @@index([entidadeId])
  @@index([status])
  @@map("pipeline_log_item")
}

enum FilaExtracaoStatus {
  PENDENTE
  CONCLUIDO
  PROCESSANDO
}

model FilaExtracaoGrupo {
  dgpId             String             @id @unique @map("dgp_id")
  nome              String
  area              String
  instituicao       String
  status            FilaExtracaoStatus @default(PENDENTE)
  tentativas        Int                @default(0)
  similares         Int                @default(1)
  criadoEm          DateTime           @default(now()) @map("criado_em")
  ultimaAtualizacao DateTime           @default(now()) @updatedAt @map("ultima_atualizacao")

  @@map("fila_extracao_grupo")
}

model FilaExtracaoPesquisador {
  lattesId          String             @id @unique @map("lattes_id")
  nome              String
  status            FilaExtracaoStatus @default(PENDENTE)
  tentativas        Int                @default(0)
  criadoEm          DateTime           @default(now()) @map("criado_em")
  ultimaAtualizacao DateTime           @default(now()) @updatedAt @map("ultima_atualizacao")

  @@map("fila_extracao_pesquisador")
}

model StgGrupoPesquisa {
  id                Int     @id @default(autoincrement())
  dgp_id            String?
  nome              String?
  ano_formacao      Int?
  area_predominante String?
  repercussao       String?
  instituicao_nome  String?
  estado            String?

  @@map("stg_grupo_pesquisa")
}

model StgPesquisador {
  id            Int     @id @default(autoincrement())
  dgp_id        String?
  nome          String?
  lattes_id     String?
  formacao      String?
  categoria     String?
  areas_atuacao String?

  @@map("stg_pesquisador")
}

model StgLinhaPesquisa {
  id              Int     @id @default(autoincrement())
  dgp_id          String?
  titulo          String?
  objetivo        String?
  setor_aplicacao String?
  palavra_chave   String?

  @@map("stg_linha_pesquisa")
}
