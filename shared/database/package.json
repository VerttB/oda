{
  "name": "@oda/database",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./prisma": {
      "types": "./dist/prisma/index.d.ts",
      "import": "./dist/prisma/index.js",
      "require": "./dist/prisma/index.js",
      "default": "./dist/prisma/index.js"
    }
  },
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');const path=require('path');const src=path.join(__dirname,'generated/prisma');const dest=path.join(__dirname,'dist/prisma');fs.cpSync(src,dest,{recursive:true});console.log('Copied Prisma client to dist/prisma')\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed"
  },
  "dependencies": {
    "@oda/shared-types": "workspace:*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/client-runtime-utils": "^7.8.0"
  },
  "devDependencies": {
    "prisma": "^7.8.0",
    "typescript": "^5.7.3",
    "ts-node": "^10.9.2",
    "dotenv": "^16.6.1",
    "@types/node": "^24.13.2"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}